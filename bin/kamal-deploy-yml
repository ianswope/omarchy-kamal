#!/usr/bin/env python3
"""Read one Kamal config/deploy.yml and print the few facts the widget needs.

A reporter. It opens one file, parses it as YAML, and writes JSON to stdout --
it never connects to anything and never looks at .kamal/secrets values.

Kamal's own schema is the source of truth for the shapes handled here:
  service:          the container label every probe filters on
  servers:          either a bare host list or role -> {hosts, cmd, proxy}
  proxy: host/hosts the name the health check is made against
  proxy: ssl        whether kamal-proxy terminates TLS itself
  ssh: user         the login the docker read runs as (kamal defaults to root)
"""

import json
import sys


def fail(message):
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(0)


try:
    import yaml
except ImportError:
    # Not fatal to the widget: the app can still be probed if the config names
    # url/service/ssh explicitly. Say precisely what is missing.
    fail("python yaml module not installed (pacman -S python-yaml)")

if len(sys.argv) < 2:
    fail("usage: kamal-deploy-yml <path to config/deploy.yml>")

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as handle:
        # safe_load, never load: a deploy.yml is a config file, but it is still
        # input, and full load constructs arbitrary python objects.
        doc = yaml.safe_load(handle)
except FileNotFoundError:
    fail("no config/deploy.yml at %s" % path)
except Exception as exc:  # noqa: BLE001 - any parse error is reported, not raised
    fail("could not parse %s: %s" % (path, exc.__class__.__name__))

if not isinstance(doc, dict):
    fail("%s is not a YAML mapping" % path)

service = doc.get("service") or ""

# --- roles and their hosts -------------------------------------------------
# `servers:` is either a list (one implicit "web" role) or a mapping of role
# name to a host list or to {hosts:, cmd:, proxy:}.
roles = []
servers = doc.get("servers")
if isinstance(servers, list):
    roles.append({"name": "web", "hosts": [str(h) for h in servers], "proxied": True})
elif isinstance(servers, dict):
    for name, spec in servers.items():
        hosts, proxied = [], True
        if isinstance(spec, list):
            hosts = [str(h) for h in spec]
        elif isinstance(spec, dict):
            raw = spec.get("hosts") or []
            if isinstance(raw, list):
                hosts = [str(h) for h in raw]
            elif raw:
                hosts = [str(raw)]
            # proxy: false marks a role nothing routes to -- a jobs container,
            # typically. It is why this widget reports roles at all: no health
            # check anywhere will notice that one has died.
            proxied = spec.get("proxy", True) is not False
        roles.append({"name": str(name), "hosts": hosts, "proxied": proxied})

# --- the name the health check is made against -----------------------------
proxy = doc.get("proxy") if isinstance(doc.get("proxy"), dict) else {}
host = ""
if proxy.get("host"):
    host = str(proxy["host"])
elif isinstance(proxy.get("hosts"), list) and proxy["hosts"]:
    host = str(proxy["hosts"][0])

healthcheck = proxy.get("healthcheck") if isinstance(proxy.get("healthcheck"), dict) else {}
health_path = str(healthcheck.get("path") or "/up")
if not health_path.startswith("/"):
    health_path = "/" + health_path

ssh = doc.get("ssh") if isinstance(doc.get("ssh"), dict) else {}

print(json.dumps({
    "ok": True,
    "error": "",
    "service": str(service),
    "roles": roles,
    "proxyHost": host,
    # Reported, not acted on: the app may still be reached over https through a
    # separate edge (nginx + certbot), which is exactly PromoEQP.com's shape.
    "proxySsl": proxy.get("ssl", False) is True,
    "healthPath": health_path,
    "sshUser": str(ssh.get("user") or "root"),
    "destination": str(doc.get("destination") or ""),
}))
